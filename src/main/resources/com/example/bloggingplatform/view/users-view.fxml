<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- User table (admins): create, edit and delete accounts and change their role. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bloggingplatform.controller.UserController" styleClass="screen">
    <fx:define>
        <VBox fx:id="form" styleClass="form" prefWidth="460">
            <Label fx:id="formMessage" styleClass="form-message" wrapText="true" maxWidth="Infinity"/>
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField"/>
            <Label fx:id="usernameError" styleClass="field-error" wrapText="true"/>
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField"/>
            <Label fx:id="emailError" styleClass="field-error" wrapText="true"/>
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"/>
            <Label fx:id="passwordHint" styleClass="hint" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="passwordError" styleClass="field-error" wrapText="true"/>
            <Label text="Role" styleClass="field-label"/>
            <ComboBox fx:id="roleBox" maxWidth="Infinity"/>
            <Label fx:id="roleError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </fx:define>

    <HBox styleClass="screen-header">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Users" styleClass="screen-title"/>
            <Label fx:id="countLabel" styleClass="screen-subtitle"/>
        </VBox>
        <Button fx:id="newButton" text="New user" styleClass="btn-create" onAction="#onNew"/>
    </HBox>
    <FlowPane styleClass="filter-bar">
        <Label text="Role" styleClass="filter-label"/>
        <ComboBox fx:id="roleFilter" prefWidth="160" onAction="#onFilterChanged"/>
    </FlowPane>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50" maxWidth="70"/>
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="150"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="240"/>
            <TableColumn fx:id="roleColumn" text="Role" prefWidth="100"/>
            <TableColumn fx:id="createdColumn" text="Joined" prefWidth="130"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="135" minWidth="135" maxWidth="135"/>
        </columns>
        <placeholder>
            <Label text="No users match."/>
        </placeholder>
    </TableView>
</VBox>
