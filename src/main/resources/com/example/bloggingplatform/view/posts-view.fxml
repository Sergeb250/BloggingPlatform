<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Post table: "My posts" for authors, every post for admins. Read / Edit / Publish / Delete sit
     in each row; the post editor opens in a pop-up. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bloggingplatform.controller.PostController" styleClass="screen">
    <fx:define>
        <!-- the "New post" / "Edit post" pop-up -->
        <VBox fx:id="form" styleClass="form" prefWidth="620">
            <Label fx:id="formMessage" styleClass="form-message" wrapText="true" maxWidth="Infinity"/>
            <Label text="Title (3-200 characters)" styleClass="field-label"/>
            <TextField fx:id="titleField" promptText="A clear, catchy title"/>
            <Label fx:id="titleError" styleClass="field-error" wrapText="true"/>
            <HBox styleClass="form-row">
                <VBox fx:id="authorCell" HBox.hgrow="ALWAYS" styleClass="form-cell">
                    <Label text="Author" styleClass="field-label"/>
                    <ComboBox fx:id="authorBox" maxWidth="Infinity"/>
                    <Label fx:id="authorError" styleClass="field-error" wrapText="true"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="form-cell">
                    <Label text="Status" styleClass="field-label"/>
                    <ComboBox fx:id="statusBox" maxWidth="Infinity"/>
                    <Label fx:id="statusError" styleClass="field-error" wrapText="true"/>
                </VBox>
            </HBox>
            <Label text="Tags (type a tag and press Enter)" styleClass="field-label"/>
            <!-- chosen tags as chips, followed by the field where a new one is typed -->
            <FlowPane fx:id="tagInput" styleClass="tag-input">
                <TextField fx:id="newTagField" styleClass="tag-input-field" prefColumnCount="14"
                           promptText="e.g. spring-boot" onAction="#onAddTag"/>
            </FlowPane>
            <Label fx:id="tagsError" styleClass="field-error" wrapText="true"/>
            <HBox fx:id="suggestionRow" styleClass="tag-suggestions-row">
                <Label fx:id="suggestionLabel" text="Your tags:" styleClass="hint"/>
                <FlowPane fx:id="tagSuggestions" styleClass="tag-suggestions" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Content (at least 20 characters; leave a blank line between paragraphs)" styleClass="field-label"/>
            <TextArea fx:id="contentArea" wrapText="true" prefRowCount="10"/>
            <Label fx:id="contentError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </fx:define>

    <HBox styleClass="screen-header">
        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="screenTitle" text="Posts" styleClass="screen-title"/>
            <Label fx:id="stats" styleClass="screen-subtitle"/>
        </VBox>
        <Button fx:id="newButton" text="New post" styleClass="btn-create" onAction="#onNew"/>
    </HBox>
    <FlowPane styleClass="filter-bar">
        <Label text="Status" styleClass="filter-label"/>
        <ComboBox fx:id="statusFilter" prefWidth="140" onAction="#onFilterChanged"/>
        <Label text="Tag" styleClass="filter-label"/>
        <ComboBox fx:id="tagFilter" prefWidth="150" onAction="#onFilterChanged"/>
        <Label fx:id="authorFilterLabel" text="Author" styleClass="filter-label"/>
        <ComboBox fx:id="authorFilter" prefWidth="180" onAction="#onFilterChanged"/>
        <Button text="Reset filters" onAction="#onResetFilters"/>
    </FlowPane>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <!-- column sorting is off because the table holds one page of posts only -->
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="260" minWidth="130" sortable="false"/>
            <TableColumn fx:id="authorColumn" text="Author" prefWidth="85" minWidth="65" sortable="false"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="96" minWidth="96" sortable="false"/>
            <TableColumn fx:id="tagsColumn" text="Tags" prefWidth="120" minWidth="70" sortable="false"/>
            <TableColumn fx:id="commentsColumn" text="Comments" prefWidth="94" minWidth="94" sortable="false"/>
            <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="68" minWidth="68" sortable="false"/>
            <TableColumn fx:id="updatedColumn" text="Updated" prefWidth="102" minWidth="102" sortable="false"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150" minWidth="150" maxWidth="150"/>
        </columns>
        <placeholder>
            <Label text="No posts match the current filters."/>
        </placeholder>
    </TableView>
    <HBox styleClass="pager">
        <Label fx:id="pageInfo" styleClass="hint"/>
        <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
    </HBox>
</VBox>
