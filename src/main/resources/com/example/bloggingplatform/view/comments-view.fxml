<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Comment table: every comment (admin), comments on my posts (author) or my comments. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bloggingplatform.controller.CommentController" styleClass="screen">
    <fx:define>
        <VBox fx:id="form" styleClass="form" prefWidth="500">
            <Label fx:id="formMessage" styleClass="form-message" wrapText="true" maxWidth="Infinity"/>
            <Label text="Post" styleClass="field-label"/>
            <ComboBox fx:id="postBox" maxWidth="Infinity"/>
            <Label fx:id="postError" styleClass="field-error" wrapText="true"/>
            <VBox fx:id="userCell">
                <Label text="Written by" styleClass="field-label"/>
                <ComboBox fx:id="userBox" maxWidth="Infinity"/>
                <Label fx:id="userError" styleClass="field-error" wrapText="true"/>
            </VBox>
            <Label text="Comment (2-2000 characters)" styleClass="field-label"/>
            <TextArea fx:id="contentArea" wrapText="true" prefRowCount="7"/>
            <Label fx:id="contentError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </fx:define>

    <HBox styleClass="screen-header">
        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="screenTitle" text="Comments" styleClass="screen-title"/>
            <Label fx:id="countLabel" styleClass="screen-subtitle"/>
        </VBox>
        <Button fx:id="newButton" text="New comment" styleClass="btn-create" onAction="#onNew"/>
    </HBox>
    <FlowPane styleClass="filter-bar">
        <Label text="Post" styleClass="filter-label"/>
        <ComboBox fx:id="postFilter" prefWidth="320" onAction="#onFilterChanged"/>
    </FlowPane>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50" maxWidth="70"/>
            <TableColumn fx:id="postColumn" text="Post" prefWidth="210"/>
            <TableColumn fx:id="userColumn" text="Written by" prefWidth="100"/>
            <TableColumn fx:id="contentColumn" text="Comment" prefWidth="330"/>
            <TableColumn fx:id="createdColumn" text="Created" prefWidth="125"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="135" minWidth="135" maxWidth="135"/>
        </columns>
        <placeholder>
            <Label text="No comments yet."/>
        </placeholder>
    </TableView>
</VBox>
