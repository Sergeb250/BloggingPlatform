<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tag table (admins): create, rename and delete tags. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bloggingplatform.controller.TagController" styleClass="screen">
    <fx:define>
        <VBox fx:id="form" styleClass="form" prefWidth="420">
            <Label fx:id="formMessage" styleClass="form-message" wrapText="true" maxWidth="Infinity"/>
            <Label text="Name" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="e.g. spring-boot"/>
            <Label text="Saved in lower case with hyphens: &quot;Spring Boot&quot; becomes spring-boot."
                   styleClass="hint" wrapText="true"/>
            <Label fx:id="nameError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </fx:define>

    <HBox styleClass="screen-header">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Tags" styleClass="screen-title"/>
            <Label fx:id="countLabel" styleClass="screen-subtitle"/>
        </VBox>
        <Button fx:id="newButton" text="New tag" styleClass="btn-create" onAction="#onNew"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" maxWidth="760">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" maxWidth="80"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="300"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100" minWidth="100" maxWidth="100"/>
        </columns>
        <placeholder>
            <Label text="No tags yet."/>
        </placeholder>
    </TableView>
</VBox>
